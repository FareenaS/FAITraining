@model SampleMvcApp.Models.EmpTable
@{ 
    var items = ViewBag.AllItems as List<SelectListItem>;
    var options = new AjaxOptions { UpdateTargetId = "ajaxSection", InsertionMode = InsertionMode.Replace };
}
<div>
    <h2>New Employee Registration</h2>
    <hr />
    <div>
        @using (Ajax.BeginForm(options))
        {
            <p>Enter the Employee Name: @Html.EditorFor((m) => m.EmpName)</p>
            <p>Enter the Employee Address: @Html.EditorFor((m) => m.EmpAddress)</p>
            <p>Enter the Employee Salary: @Html.EditorFor((m) => m.EmpSalary)</p>
            <p>Enter the Employee Date Of Birth: @Html.EditorFor((m) => m.DateOfBirth)</p>
            <p>Select Dept: @Html.DropDownListFor((m) => m.DeptId, items)</p>
            <button>Save Changes</button>
        }
    </div>
</div>
